# Coolify settings for this independent web repository. Examples, not live values.
# Enter values in Coolify; do not overwrite the native-development .env.
WEB_HOST=menu.example.com
# Existing external Docker network containing BOTH gateway and API.
# Replace this example with the exact inspected network name.
WAYTA_GATEWAY_NETWORK=existing-wayta-network
# Bare, server-only API origin resolvable on that network, not the frontend URL.
# api is illustrative; verify the existing API's DNS name. No /api/v1 suffix.
API_INTERNAL_URL=http://api:4000
# Existing gateway expects web:3000. Do not activate duplicate aliases.
# For staging beside the old frontend, use a unique alias until the coordinated cutover.
WAYTA_WEB_ALIAS=web
# Keep empty if restaurant subdomains are not already enabled.
# When enabled, use the same bare base domain as the existing backend/gateway.
RESTAURANT_BASE_DOMAIN=
